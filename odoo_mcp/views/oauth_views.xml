<odoo>
    <record id="oauth_client_list" model="ir.ui.view">
        <field name="name">odoo.mcp.oauth.client.list</field>
        <field name="model">odoo.mcp.oauth.client</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="client_id"/><field name="active"/></list>
        </field>
    </record>
    <record id="oauth_client_form" model="ir.ui.view">
        <field name="name">odoo.mcp.oauth.client.form</field>
        <field name="model">odoo.mcp.oauth.client</field>
        <field name="arch" type="xml">
            <form string="MCP OAuth Client">
                <header>
                    <button name="action_generate_secret" type="object" string="Generate / Rotate Client Secret" class="oe_highlight"
                            confirm="This enables the client and revokes its existing OAuth connections. Copy the new secret from the notification; it is shown only once."/>
                </header>
                <sheet>
                    <group><field name="name"/><field name="active"/><field name="client_id"/></group>
                    <group string="Connection"><field name="server_url"/><field name="authorization_url"/><field name="token_url"/></group>
                    <group string="Allowed callbacks"><field name="redirect_uris"/></group>
                    <div class="alert alert-info" role="alert">
                        Select OAuth in ChatGPT and enter the Client ID above and generated client secret.
                        The default callback supports ChatGPT's stable redirect. If ChatGPT shows a different
                        callback URL, copy that exact HTTPS URL here. Tokens preserve the consenting user's
                        Odoo permissions and work only at the MCP endpoint.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="oauth_grant_list" model="ir.ui.view">
        <field name="name">odoo.mcp.oauth.grant.list</field>
        <field name="model">odoo.mcp.oauth.grant</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="client_id"/><field name="user_id"/><field name="company_id"/>
                <field name="scope"/><field name="expires_at"/><field name="revoked"/>
                <button name="action_revoke" type="object" string="Revoke" invisible="revoked"/>
            </list>
        </field>
    </record>
    <record id="oauth_client_action" model="ir.actions.act_window">
        <field name="name">OAuth Clients</field><field name="res_model">odoo.mcp.oauth.client</field>
        <field name="view_mode">list,form</field><field name="context">{'active_test': False}</field>
    </record>
    <record id="oauth_grant_action" model="ir.actions.act_window">
        <field name="name">OAuth Connections</field><field name="res_model">odoo.mcp.oauth.grant</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="oauth_menu" name="MCP" parent="base.menu_administration" groups="base.group_system" sequence="90"/>
    <menuitem id="oauth_client_menu" name="OAuth Clients" parent="oauth_menu" action="oauth_client_action" sequence="10"/>
    <menuitem id="oauth_grant_menu" name="OAuth Connections" parent="oauth_menu" action="oauth_grant_action" sequence="20"/>
    <data noupdate="1">
        <record id="oauth_chatgpt_client" model="odoo.mcp.oauth.client"><field name="name">ChatGPT</field></record>
    </data>
    <template id="oauth_consent" name="MCP OAuth Consent">
        <html lang="en">
            <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Connect to Odoo MCP</title>
                <style>body{font:16px system-ui,sans-serif;background:#f5f5f7;color:#202026;margin:0;padding:40px 20px}main{max-width:620px;margin:auto;background:white;padding:32px;border-radius:12px}h1{font-size:26px}li{margin:12px 0}button{padding:12px 20px;border-radius:6px;border:1px solid #777;font:inherit;cursor:pointer;margin:8px 8px 0 0}.approve{background:#714b67;color:white;border:0}.small{color:#555;font-size:14px}</style>
            </head>
            <body><main>
                <h1>Connect <t t-out="client_name"/> to Odoo?</h1>
                <p>Signed in as <strong t-out="user_name"/> for <strong t-out="company_name"/>.</p>
                <p>This connection may use the following capabilities within your existing Odoo permissions:</p>
                <ul>
                    <li>Read sales, stock, lots, invoices, CRM, joined Discuss channels, and your assigned personal To-dos.</li>
                    <li t-if="'mcp.crm.write' in granted_scopes">Create and update CRM leads, opportunities and activities.</li>
                    <li t-if="'mcp.chat.write' in granted_scopes">Send Discuss messages and add internal notes to supported record chatter.</li>
                    <li t-if="'mcp.todo.write' in granted_scopes">Create, edit, complete, reopen and cancel your assigned personal To-dos.</li>
                    <li t-if="'offline_access' in granted_scopes">Keep the connection active for up to 30 days, until you reconnect or an administrator revokes it.</li>
                </ul>
                <p>Sales, inventory, lots and invoice business fields remain read-only. Messages may notify channel members or followers.</p>
                <form action="/odoo_mcp/oauth/consent" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="nonce" t-att-value="nonce"/>
                    <button type="submit" name="decision" value="approve" class="approve">Allow connection</button>
                    <button type="submit" name="decision" value="deny">Deny</button>
                </form>
                <p class="small">Only continue if you started this connection in the named app. No Odoo password or general-purpose API key is shared with it.</p>
            </main></body>
        </html>
    </template>
</odoo>
